{
  "name": "playwright-project",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:uat": "cross-env TEST_ENV=uat playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test": "playwright test",
    "test:ci": "cross-env CI=true playwright test --reporter=list,html",
    "docker:build": "docker build -t playwright-project:latest .",
    "docker:run": "docker run --rm -e CI=true -e TEST_ENV=qa -v ${PWD}:/home/pwuser/app -w /home/pwuser/app -v /dev/shm:/dev/shm playwright-project:latest",
    "test:docker": "npm run docker:build && npm run docker:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure-playwright": "^3.8.0",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
